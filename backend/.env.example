NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/attendly
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
COOKIE_NAME=attendly_auth
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_MAX_AGE_MS=900000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
# For separate HTTPS production origins use COOKIE_SAME_SITE=none,
# COOKIE_SECURE=true, and set FRONTEND_ORIGINS to the exact Netlify URL.
ADMIN_NAME=Demo Administrator
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_DEPARTMENT=Administration
TEACHER_NAME=Demo Teacher
TEACHER_EMAIL=teacher@example.edu
TEACHER_PASSWORD=replace-with-a-strong-teacher-password
TEACHER_DEPARTMENT=Computer Science
TEACHER_2_NAME=Dr. Nadia Islam
TEACHER_2_EMAIL=nadia.islam@example.edu
TEACHER_2_PASSWORD=replace-with-a-strong-teacher-password
TEACHER_3_NAME=Dr. Imran Hossain
TEACHER_3_EMAIL=imran.hossain@example.edu
TEACHER_3_PASSWORD=replace-with-a-strong-teacher-password
